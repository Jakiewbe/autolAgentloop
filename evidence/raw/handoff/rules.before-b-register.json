{
  "sources": {
    "local": {
      "name": "本机"
    }
  },
  "agents": {
    "agent": {
      "name": "Agent",
      "worker": "desktop-lm7rki1",
      "use": "command",
      "command": [
        "C:\\Users\\chs\\AppData\\Local\\OpenAI\\Codex\\bin\\22cfb1d302613eae\\codex.exe",
        "exec",
        "{resumeArgs}",
        "--skip-git-repo-check",
        "{cwdArgs}",
        "--json",
        "{prompt}"
      ]
    },
    "slowtest": {
      "name": "慢测",
      "worker": "desktop-lm7rki1",
      "use": "command",
      "command": [
        "cmd",
        "/c",
        "ping -n 40 127.0.0.1 >nul & echo 慢测完成"
      ]
    },
    "claude-go-review": {
      "name": "Claude Code / DeepSeek（只读验收）",
      "worker": "desktop-lm7rki1",
      "use": "claude-go",
      "command": [
        "C:\\Users\\chs\\AppData\\Roaming\\npm\\node_modules\\@anthropic-ai\\claude-code\\bin\\claude.exe",
        "C:\\Users\\chs\\.agent-autoloop\\claude-go-reviewed-20261104.json"
      ],
      "model": "deepseek-v4.1-flash",
      "access": "read",
      "timeout": 3
    }
  },
  "channels": {
    "desktop": {
      "name": "桌面通知"
    }
  },
  "rules": [
    {
      "name": "试一下",
      "when": {
        "source": "local",
        "types": [
          "try.*"
        ]
      },
      "to": "agent",
      "cwd": "C:\\Users\\chs\\.agent-autoloop\\try",
      "prompt": "这是 agent-autoloop try 的试跑，不要改任何文件，不要做别的事。读资料文件。如果 answers 是空的，就问一个问题：title 写“试跑：选一个颜色”，text 写“这是一次试跑，选哪个都行。”，options 写 [\"蓝色\",\"绿色\"]，key 写 try-color，第一行结论写“问了一个问题”。如果 answers 不是空的，第一行结论写“你选了某某，试跑通过”，把某某换成 answers 里选的那一项，不附回执。"
    },
    {
      "name": "演练断电",
      "when": {
        "source": "local",
        "types": [
          "cuttest.*"
        ]
      },
      "to": "slowtest",
      "cwd": "~/.agent-autoloop/try",
      "prompt": "慢测",
      "tell": "never"
    },
    {
      "name": "A-Claude只读验收",
      "when": {
        "source": "local",
        "types": [
          "review.claude"
        ]
      },
      "to": "claude-go-review",
      "cwd": "D:\\Vibe_coding-Project\\autoAgentloop\\evidence\\current-review\\fixture",
      "prompt": "本轮只读验收，不修改任何文件、不运行命令、不访问其他项目或网络，不创建子代理。读取中台资料JSON。如果answers为空，用ask回执提问，title为“验收确认”，options为[“继续”,“暂停”]，key为review-confirm；第一行写“等待验收确认”。如果answers非空，读取先前会话，第一行只写“A_RUNTIME_RESUME_OK”，不再次提问。",
      "group": "a-runtime-verification",
      "tell": "needed"
    }
  ],
  "elsewhere": []
}