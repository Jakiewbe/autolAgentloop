   1: #!/usr/bin/env bash
   2: set -u
   3: CODEX="C:/Users/chs/AppData/Local/OpenAI/Codex/bin/22cfb1d302613eae/codex.exe"; WD="D:/Vibe_coding-Project/autoAgentloop/evidence/raw/adapters/work/codex-min"; BASE="D:/Vibe_coding-Project/autoAgentloop/evidence/raw/adapters"
   4: TS=$(date +%Y%m%dT%H%M%S%z)
   5: JSONL="$BASE/"$TS"_codex166_cancel_sigterm.jsonl"
   6: ERRF="$BASE/"$TS"_codex166_cancel_sigterm.stderr.txt"
   7: cd "$WD" || exit 9
   8: PROMPT="Run exactly this command and wait for it to finish: Start-Sleep -Seconds 120 . Then report that it finished."
   9: START=$(date +%s)
  10: timeout -k 3 20 "$CODEX" exec --skip-git-repo-check --json -C "$WD" "$PROMPT" >"$JSONL" 2>"$ERRF"
  11: CODE=$?; END=$(date +%s)
  12: echo "timeout_wrapped_exit_code=$CODE (124=timeout fired, 137=kill)"
  13: echo "elapsed_s=$((END-START))"
  14: echo "--- turn.completed count (expect 0 if cancelled mid-turn) ---"; grep -c "turn.completed" "$JSONL" || true
  15: echo "--- event types ---"; grep -oE '"type":"[a-z._]+"' "$JSONL" | sort | uniq -c
  16: echo "--- orphan check: pwsh still running Start-Sleep 120 ---"
  17: wmic process where "name='pwsh.exe'" get processid,parentprocessid,commandline 2>/dev/null | grep -i "Start-Sleep" | cut -c1-200 || echo "(none)"
  18: echo "--- orphan check: codex exec still running ---"
  19: wmic process where "name='codex.exe'" get processid,commandline 2>/dev/null | grep -i " exec " | cut -c1-160 || echo "(none)"
  20: { echo "tag=codex166_cancel_sigterm"; echo "started=$TS"; echo "exit_code=$CODE"; echo "jsonl=$JSONL"; echo "stderr=$ERRF"; } > "$BASE/"$TS"_codex166_cancel_sigterm.meta.txt"
