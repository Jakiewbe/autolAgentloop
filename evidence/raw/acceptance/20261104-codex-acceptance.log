   1: // The bridge decides what may be handed out; these are the cases where it must say no. Failure it guards against: a
   2: // draft task, a task waiting on another, a task whose delivery files are not declared, a task whose scope changed after
   3: // approval, or a task already being worked on, being handed to an agent as if it were ready.
   4: import assert from "node:assert/strict";
   5: import { test } from "node:test";
   6: import { objection, subjectOf } from "./bridge.mjs";
   7: 
   8: const ready = (over = {}) => ({
   9:   task_id: "T1",
  10:   plan: "approved",
  11:   status: "todo",
  12:   dependencies: [],
  13:   deliverable_coverage: "covered",
  14:   scope_dirty: false,
  15:   legacy_unverified: false,
  16:   ...over,
  17: });
  18: const deps = (...tasks) => new Map(tasks.map((task) => [task.task_id, task]));
  19: 
  20: test("a task that is approved, unblocked and declared is claimable", () => {
  21:   assert.equal(objection(ready(), deps(ready())), null);
  22: });
  23: 
  24: test("a draft task is not claimable", () => {
  25:   assert.match(objection(ready({ plan: "draft" }), deps(ready())), /没有批准/);
  26: });
  27: 
  28: test("a task whose dependency is not done waits", () => {
  29:   const after = ready({ task_id: "T2", dependencies: ["T1"] });
  30:   assert.match(objection(after, deps(ready({ status: "doing" }), after)), /依赖未完成：T1/);
  31: });
  32: 
  33: test("a task whose delivery files are not declared waits", () => {
  34:   assert.match(objection(ready({ deliverable_coverage: "missing" }), deps()), /交付未声明/);
  35: });
  36: 
  37: test("a task whose scope changed after approval waits for a new approval", () => {
  38:   assert.match(objection(ready({ scope_dirty: true }), deps()), /重新批准/);
  39: });
  40: 
  41: test("a task already being worked on is not handed out twice", () => {
  42:   assert.match(objection(ready({ status: "doing" }), deps()), /已经在做/);
  43: });
  44: 
  45: test("a non-ASCII project name still yields an address the center accepts", () => {
  46:   const subject = subjectOf("数字生命 项目", "T8");
  47:   assert.match(subject, /^[A-Za-z0-9#._:/@-]+$/);
  48:   assert.equal(subjectOf("", ""), "task/project/project");
  49: });
  50: 
  51: test("a blocked task says it is blocked, not that it waits on a dependency", () => {
  52:   assert.match(objection(ready({ status: "blocked" }), deps()), /自身被阻塞/);
  53: });

