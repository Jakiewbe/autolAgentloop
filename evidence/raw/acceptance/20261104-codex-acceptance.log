   1: // What the kernel reads in rules: their shape and which events a rule takes. The rules file is checked before it gets
   2: // here, in protocol/rules.ts.
   3: export type Access = "read" | "edit" | "full";
   4: export type Source = { name: string; adapter?: string };
   5: type AgentOptions = { model?: string; effort?: string; command?: string[]; timeout?: number };
   6: export type Agent = AgentOptions & { name: string; worker: string; use: string; access: Access };
   7: export type Channel = { name: string; answerers?: string[]; links?: boolean };
   8: export type Tell = "always" | "needed" | "never";
   9: type EventFilter = { source: string; types: string[] };
  10: type When = EventFilter | { cron: string };
  11: type RuleOptions = { skill?: string; prompt?: string; parallel?: number; emits?: EventFilter };
  12: /** Without parallel a rule's group runs one at a time; with it, each subject is its own thread, that many at once. */
  13: export type Rule = RuleOptions & { name: string; when: When; to: string; cwd: string; group: string; tell: Tell };
  14: /** A scheduled task that runs elsewhere (say, in the Claude app): the hub neither starts nor records it. */
  15: export type Elsewhere = { name: string; source: string; to: string; cron: string; where: string };
  16: type Registered = { sources: Record<string, Source>; agents: Record<string, Agent>; channels: Record<string, Channel> };
  17: export type Rules = Registered & { timezone: string; askFirst: string[]; rules: Rule[]; elsewhere: Elsewhere[] };
  18: 
  19: /** The source of what the clock makes happen. */
  20: export const SCHEDULE = "schedule";
  21: 
  22: function typeMatch(pattern: string, type: string) {
  23:   return pattern === "*" || pattern === type || (pattern.endsWith(".*") && type.startsWith(pattern.slice(0, -1)));
  24: }
  25: export const typeMatches = (patterns: string[], type: string) => patterns.some((pattern) => typeMatch(pattern, type));
  26: export const eventRule = (rule: Rule): rule is Rule & { when: EventFilter } => "source" in rule.when;
  27: export const cronOf = (rule: Rule) => (rule.when as { cron: string }).cron;
