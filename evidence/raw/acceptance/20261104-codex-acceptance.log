 148: /** Keeps an event under a key of its own: one the hub makes up mustn't collide with one a source sent. */
 149: function recordEvent(draft: Draft, source: string, event: Row, routed: string[]): number {
 150:   let key = event.id;
 151:   for (let suffix = 1; rows(draft.view, "events", { source, key }).length; suffix++) {
 152:     key = `${event.id}:${suffix}`;
 153:   }
 154:   return add(draft, "events", {
 155:     source,
 156:     key,
 157:     type: event.type,
 158:     subject: event.subject ?? "",
 159:     summary: event.summary ?? "",
 160:     detail: event.detail ?? "",
 161:     link: event.link ?? "",
 162:     hops: event.hops ?? 0,
 163:     routed: JSON.stringify(routed),
 164:     received_at: draft.at,
 165:   }).id;
 166: }
 167: 
 168: function ingest(draft: Draft, source: string, given: unknown) {
 169:   const event = parseEvent(given);
 170:   const existing = rows(draft.view, "events", { source, key: event.id })[0];
 171:   if (existing) return { event: existing.id, duplicate: true, routed: JSON.parse(existing.routed) };
 172:   const tooDeep = event.hops > MAX_HOPS;
 173:   const takes = (rule: Rule) =>
 174:     eventRule(rule) && rule.when.source === source && typeMatches(rule.when.types, event.type);
 175:   const matched = tooDeep ? [] : draft.rules.rules.filter(takes);
 176:   const routed = matched.map((rule) => rule.name);
 177:   const id = recordEvent(draft, source, event, routed);
 178:   if (tooDeep) {
 179:     const words = `同一条处理链已超过 ${MAX_HOPS} 层，后续事件已记录，没有继续派发。`;
 180:     notify(draft, `hops:${source}:${event.id}`, "事件循环已停止", words, { once: true });
 181:   }
 182:   for (const rule of matched) enqueue(draft, rule, id, event.subject);
 183:   return { event: id, duplicate: false, routed };
 184: }

