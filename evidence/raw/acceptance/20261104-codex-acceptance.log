app/host/platform.ts
   1: // Where this program meets the operating system, and the only place it does: finding a program, starting a turn so it
   2: // outlives the worker that started it, looking at it afterwards, and stopping its whole process tree. Everything else
   3: // in the program talks in these names and knows nothing about shells or process groups.
   4: import { execFileSync, spawn } from "node:child_process";
   5: import { existsSync, writeFileSync } from "node:fs";
   6: import path from "node:path";
   7: 
   8: export const WINDOWS = process.platform === "win32";
   9: /** Windows starts the turn through this: the same rules as the POSIX wrapper below, as a process that can be stopped. */
  10: const RUNNER = path.join(import.meta.dirname, "..", "worker", "runner.ts");
  11: const NODE = ["--disable-warning=ExperimentalWarning"];
  12: 
  13: const found = new Map<string, string | null>();
  14: 
  15: /** A program's path from Windows' PATH and PATHEXT, with the extension a person would not type. */
  16: export function which(name: string) {
  17:   const hasDirectory = name.includes("/") || name.includes("\\");
  18:   const extensions = !WINDOWS
  19:     ? [""]
  20:     : path.extname(name)
  21:       ? [""]
  22:       : ["", ...(process.env.PATHEXT ?? ".COM;.EXE;.BAT;.CMD").split(";")];
  23:   const directories = hasDirectory ? [""] : (process.env.PATH ?? "").split(path.delimiter);
  24:   for (const directory of directories) {
  25:     if (!hasDirectory && !directory) continue;
  26:     for (const extension of extensions) {
  27:       const file = path.resolve(directory, name + extension);
  28:       if (existsSync(file)) return file;
  29:     }
  30:   }
  31:   return null;
  32: }
  33: 
  34: const onPath = (name: string) => {
  35:   if (WINDOWS) return which(name);
  36:   // A login shell has the PATH the owner has in a terminal; a service starts with a bare one.
  37:   try {
  38:     const printed = execFileSync(process.env.SHELL ?? "/bin/sh", ["-lc", `command -v ${name}`], {
  39:       encoding: "utf8",
  40:       timeout: 15_000,
  41:       stdio: ["ignore", "pipe", "ignore"],
  42:     });
  43:     return printed.trim().split("\n").at(-1) || null;
  44:   } catch {
  45:     return null;
  46:   }
  47: };
  48: 
  49: /** Where a program is: on the PATH a person would have, or in one of the places the caller knows. */
  50: export function findProgram(name: string, elsewhere: () => string[] = () => []) {
  51:   if (!found.has(name)) found.set(name, onPath(name) ?? elsewhere().find(existsSync) ?? null);
  52:   const program = found.get(name);
  53:   if (!program) throw new Error(`找不到 ${name}：先装好并登录`);
  54:   return program;
  55: }
  56: 
  57: export type TurnFiles = { out: string; err: string; result: string };
  58: export type Launch = {
  59:   /** Program and arguments, as the adapter built them: no shell has seen them. */
  60:   argv: string[];
  61:   cwd: string;
  62:   env: NodeJS.ProcessEnv;
  63:   files: TurnFiles;
  64:   /** Where the command line is written down, in a form the process that runs it reads back. */
  65:   commandFile: string;
  66:   /** What this launch is called in the process table, so a number reused by another process isn't mistaken for it. */
  67:   marker: string;
  68:   onError?: (error: Error) => void;
  69: };
  70: 
  71: const quoted = (word: string) => `'${word.replaceAll("'", `'\\''`)}'`;
  72: 
  73: /**
  74:  * POSIX: a login shell gives the turn the PATH and sign-in its owner has in a terminal; the command waits in a file for
  75:  * /bin/sh because login shells disagree on how a command reads its arguments (fish has no $0 or $@), and because the
  76:  * install path can hold any character. Output and the exit code go through that shell, so they land in their files even
  77:  * if this program has gone by then. Detached, so the turn is its own process group: stopping it stops what it started.
  78:  */
  79: function launchPosix({ argv, cwd, env, files, commandFile, marker, onError }: Launch) {
  80:   writeFileSync(commandFile, `unset AGENT_AUTOLOOP_COMMAND\nexec ${argv.map(quoted).join(" ")}\n`, { mode: 0o600 });
  81:   const script = [
  82:     "out=$1",
  83:     "err=$2",
  84:     "result=$3",
  85:     "shift 3",
  86:     "umask 077",
  87:     '"$@" >"$out" 2>"$err"',
  88:     'echo $? >"$result.tmp"',
  89:     'mv "$result.tmp" "$result"',
  90:     // A final external command can replace the shell before publishing its exit file.
  91:     ":",
  92:   ].join("\n");
  93:   const login = [process.env.SHELL ?? "/bin/sh", "-lc", 'exec /bin/sh "$AGENT_AUTOLOOP_COMMAND"'];
  94:   const child = spawn("/bin/sh", ["-c", script, marker, files.out, files.err, files.result, ...login], {
  95:     cwd,
  96:     env: { ...env, AGENT_AUTOLOOP_COMMAND: commandFile },
  97:     detached: true,
  98:     stdio: "ignore",
  99:   });
 100:   child.on("error", (error) => onError?.(error));
 101:   child.unref();
 102:   return child.pid!;
 103: }
 104: 
 105: const CMD_SPECIAL = /[\s"&|<>^()%,;=]/;
 106: 
 107: /** One word of a command line read by cmd.exe: quoted once, here, and never handed to a second shell. */
 108: const cmdWord = (word: string) =>
 109:   CMD_SPECIAL.test(word) ? `"${word.replaceAll("%", "%%").replaceAll('"', '\\"')}"` : word;
 110: 
 111: const comspec = () => process.env.ComSpec ?? path.join(process.env.SystemRoot ?? "C:\\Windows", "System32", "cmd.exe");
 112: 
 113: export type Program = { program: string; args: string[]; shell: boolean };
 114: 
 115: /**
 116:  * Windows has no shebang and no signals: a program is a .exe, or a script only an interpreter can run. Each is started
 117:  * the way its own kind needs, and the words are passed as a list, not as a line a shell would split again. Only a
 118:  * .cmd/.bat is read by cmd.exe, because nothing else can run one; its words are quoted for that one parser.
 119:  */
 120: export function programFor(argv: string[]): Program {
 121:   const [name, ...rest] = argv;
 122:   const file = path.isAbsolute(name) || name.includes("\\") || name.includes("/") ? name : (which(name) ?? name);
 123:   const extension = path.extname(file).toLowerCase();
 124:   if (extension === ".cmd" || extension === ".bat") {
 125:     const line = [file, ...rest].map(cmdWord).join(" ");
 126:     return { program: comspec(), args: ["/d", "/s", "/c", line], shell: false };
 127:   }
 128:   if (extension === ".ps1") {
 129:     const powershell = which("pwsh") ?? which("powershell");
 130:     if (!powershell) throw new Error("找不到 PowerShell：先装好 PowerShell 7 或 Windows PowerShell");
 131:     return {
 132:       program: powershell,
 133:       args: ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", file, ...rest],
 134:       shell: false,
 135:     };
 136:   }
 137:   return { program: file, args: rest, shell: false };
 138: }
 139: 
 140: /**
 141:  * Windows: a small runner of this install's own starts the turn and waits for it, with the turn's output going straight
 142:  * into its files. It is one process to look at and one tree to stop (taskkill /T), which is what Windows offers instead
 143:  * of a process group. It outlives the worker, so a job started before a restart is still found running after one.
 144:  */
 145: function launchWindows({ argv, cwd, env, files, commandFile, marker, onError }: Launch) {
 146:   const program = programFor(argv);
 147:   writeFileSync(commandFile, `${JSON.stringify({ ...program, cwd }, null, 2)}\n`, { mode: 0o600 });
 148:   const child = spawn(process.execPath, [...NODE, RUNNER, commandFile, files.out, files.err, files.result, marker], {
 149:     cwd,
 150:     env,
 151:     detached: true,
 152:     stdio: "ignore",
 153:     windowsHide: true,
 154:   });
 155:   child.on("error", (error) => onError?.(error));
 156:   child.unref();
 157:   return child.pid!;
 158: }
 159: 
 160: /** Starts a turn as a process of its own; the pid it returns is the one that is stopped to stop the whole turn. */
 161: export function launchTurn(launch: Launch) {
 162:   return WINDOWS ? launchWindows(launch) : launchPosix(launch);
 163: }
 164: 
 165: /** Whether a process with this number is there, whether or not it is ours. */
 166: export const pidAlive = (pid: number) => {
 167:   try {
 168:     process.kill(pid, 0);
 169:     return true;
 170:   } catch (error) {
 171:     // A process this account may not open is still there.
 172:     return (error as NodeJS.ErrnoException).code === "EPERM";
 173:   }
 174: };
 175: 
 176: const lines = new Map<number, { at: number; line: string | null }>();
 177: 
 178: /** What a process was started with, for telling it apart from another process that got its number. */
 179: export function commandLineOf(pid: number) {
 180:   if (!WINDOWS) {
 181:     try {
 182:       return execFileSync("ps", ["-p", String(pid), "-o", "command="], { encoding: "utf8" });
 183:     } catch {
 184:       return null;
 185:     }
 186:   }
 187:   const known = lines.get(pid);
 188:   const moment = Date.now();
 189:   if (known && moment - known.at < 2_000) return known.line;
 190:   let line: string | null = null;
 191:   try {
 192:     const printed = execFileSync("wmic", ["process", "where", `processid=${pid}`, "get", "commandline", "/value"], {
 193:       encoding: "utf8",
 194:       timeout: 15_000,
 195:       stdio: ["ignore", "pipe", "ignore"],
 196:     });
 197:     line = /CommandLine=(.*)/.exec(printed)?.[1]?.trim() || null;
 198:   } catch {
 199:     try {
 200:       const printed = execFileSync(
 201:         "powershell",
 202:         [
 203:           "-NoProfile",
 204:           "-NonInteractive",
 205:           "-Command",
 206:           `(Get-CimInstance Win32_Process -Filter "ProcessId=${pid}").CommandLine`,
 207:         ],
 208:         { encoding: "utf8", timeout: 30_000, stdio: ["ignore", "pipe", "ignore"] },
 209:       );
 210:       line = printed.trim() || null;
 211:     } catch {
 212:       line = null;
 213:     }
 214:   }
 215:   lines.set(pid, { at: moment, line });
 216:   return line;
 217: }
 218: 
 219: /** Whether the turn started here is still the process that has its number. */
 220: export function runAlive(pid: number | undefined, marker: string) {
 221:   if (!pid) return false;
 222:   if (!WINDOWS) {
 223:     try {
 224:       return execFileSync("ps", ["-p", String(pid), "-o", "command="], { encoding: "utf8" }).includes(marker);
 225:     } catch {
 226:       return false;
 227:     }
 228:   }
 229:   if (!pidAlive(pid)) return false;
 230:   const line = commandLineOf(pid);
 231:   // Nothing can read a command line here: the number is all there is.
 232:   return line === null || line.includes(marker);
 233: }
 234: 
 235: /** Whether anything of the turn is still going: on Windows the runner waits for its turn, so it stands for the tree. */
 236: export function runTreeAlive(pid: number | undefined) {
 237:   if (!pid) return false;
 238:   if (WINDOWS) return pidAlive(pid);
 239:   try {
 240:     // The wrapper can die before a child; zombies have already stopped and only their parent can reap them.
 241:     return execFileSync("ps", ["-ax", "-o", "pgid=", "-o", "stat="], { encoding: "utf8" })
 242:       .trim()
 243:       .split("\n")
 244:       .some((line) => {
 245:         const [group, state] = line.trim().split(/\s+/);
 246:         return Number(group) === pid && !state.startsWith("Z");
 247:       });
 248:   } catch {
 249:     return false;
 250:   }
 251: }
 252: 
 253: /** Stops the turn and everything it started. Windows has no signals: the tree is ended by the console host. */
 254: export function stopRun(pid: number | undefined, force: boolean) {
 255:   if (!pid) return;
 256:   if (WINDOWS) {
 257:     // taskkill without /F refuses a console program ("只能强制终止"), and Windows hands a console program no signal to
 258:     // wind down with, so a stop here is the whole tree ended at once.
 259:     try {
 260:       execFileSync("taskkill", ["/PID", String(pid), "/T", "/F"], { stdio: "ignore", timeout: 30_000 });
 261:     } catch {}
 262:     return;
 263:   }
 264:   try {
 265:     process.kill(-pid, force ? "SIGKILL" : "SIGTERM");
 266:   } catch {}
 267: }
app/worker/runner.ts
   1: // Runs one turn on Windows: starts the agent where the worker said, puts its output in the files the worker reads, and
   2: // publishes its exit code where the worker looks for it. It is the process the worker's pid names, so stopping it
   3: // (taskkill /T) stops everything the turn started, and it outlives the worker, so a turn started before a restart is
   4: // still found running after one. Nothing here goes through a shell: the words arrive as a list.
   5: import { spawn } from "node:child_process";
   6: import { closeSync, openSync, readFileSync, renameSync, writeFileSync } from "node:fs";
   7: 
   8: const [commandFile, out, err, result, marker] = process.argv.slice(2);
   9: const spec = JSON.parse(readFileSync(commandFile, "utf8")) as { program: string; args: string[]; shell?: boolean };
  10: 
  11: /** The worker reads the exit code from this file; it is written whole, then renamed, so it never reads half. */
  12: function publish(code: number) {
  13:   try {
  14:     writeFileSync(`${result}.tmp`, String(code));
  15:     renameSync(`${result}.tmp`, result);
  16:   } catch {}
  17: }
  18: 
  19: const stdout = openSync(out, "w");
  20: const stderr = openSync(err, "w");
  21: // The marker is only here so the process table carries it: the worker tells its own turn apart from a number reused.
  22: const child = spawn(spec.program, spec.args, {
  23:   stdio: ["ignore", stdout, stderr],
  24:   windowsHide: true,
  25:   shell: spec.shell === true,
  26: });
  27: 
  28: child.on("error", (error) => {
  29:   try {
  30:     writeFileSync(err, `${error}\n`);
  31:   } catch {}
  32:   publish(127);
  33:   closeSync(stdout);
  34:   closeSync(stderr);
  35:   process.exit(127);
  36: });
  37: 
  38: child.on("exit", (code, signal) => {
  39:   publish(code ?? (signal === "SIGTERM" ? 143 : signal === "SIGKILL" ? 137 : 1));
  40:   closeSync(stdout);
  41:   closeSync(stderr);
  42:   process.exit(0);
  43: });
  44: 
  45: // Nothing to do but wait: the marker keeps this process identifiable while the turn runs.
  46: void marker;
app/tests/windows-runtime.test.ts
   1: // Windows has no /bin/sh, no signals and no process groups, so the way a turn is started, looked at and stopped is
   2: // different there; these are the checks for that way, on Windows only. They run real processes: a turn started in a
   3: // folder with a space and Chinese in its path, a turn stopped with the child it started, a turn over its time, and a
   4: // worker restarted while a turn is still going. What matters is what the operating system shows afterwards: no process
   5: // left, and the exit code and the result where the worker looks for them. The POSIX side keeps its checks in
   6: // worker.test.ts, which needs /bin/sh and so cannot run here.
   7: import assert from "node:assert/strict";
   8: import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
   9: import { join } from "node:path";
  10: import { test } from "node:test";
  11: import { WINDOWS, launchTurn, pidAlive, runAlive, runTreeAlive, stopRun } from "../host/platform.ts";
  12: import { setup } from "./helpers.ts";
  13: 
  14: const home = setup("windows-runtime");
  15: // A folder a Windows path often is: a space and Chinese in it, which is where quoting goes wrong.
  16: const folder = join(home, "project 目录");
  17: mkdirSync(folder, { recursive: true });
  18: 
  19: const { createWorker } = await import("../worker/worker.ts");
  20: 
  21: const scriptFile = (name: string, body: string) => {
  22:   const file = join(home, name);
  23:   writeFileSync(file, body.trimStart());
  24:   return file;
  25: };
  26: 
  27: /** Ticks until `done`, or fails: a test that waits for ever is a test that hides a hang. */
  28: async function until(done: () => boolean) {
  29:   const end = Date.now() + 30_000;
  30:   while (!done()) {
  31:     assert.ok(Date.now() < end, "等了 30 秒还没好");
  32:     await new Promise((again) => setTimeout(again, 50));
  33:   }
  34: }
  35: 
  36: /** The worker's own round, over and over: it is what looks at a run, so nothing happens without it. */
  37: async function drive(worker: { tick(): Promise<boolean> }, done: () => boolean) {
  38:   const end = Date.now() + 30_000;
  39:   while (!done()) {
  40:     assert.ok(Date.now() < end, "30 秒内没收住这一轮");
  41:     await worker.tick();
  42:     await new Promise((again) => setTimeout(again, 100));
  43:   }
  44: }
  45: 
  46: const jobFor = (over: { run: number; command: string[]; timeout?: number }) => ({
  47:   run: over.run,
  48:   token: `token-${over.run}`,
  49:   attempt: 1,
  50:   session: null,
  51:   askFirst: [],
  52:   rule: { name: "跑一下", cwd: folder, prompt: "做点事。" },
  53:   agent: { id: "a", name: "甲", use: "command", access: "edit", command: over.command, timeout: over.timeout },
  54:   context: { events: [], answers: [], timers: [], waiting: [], open: [], decided: [] },
  55: });
  56: 
  57: function fakeHub() {
  58:   const hub = {
  59:     jobs: [] as any[],
  60:     results: [] as any[],
  61:     async work(query: any) {
  62:       return { job: query.capacity ? (hub.jobs.shift() ?? null) : null, cancel: [] };
  63:     },
  64:     async started() {
  65:       return { ok: true };
  66:     },
  67:     async result(run: number, token: string, body: any) {
  68:       hub.results.push({ run, token, ...body });
  69:       return { rejected: [] };
  70:     },
  71:   };
  72:   return hub;
  73: }
  74: 
  75: const runFolder = (run: number) => join(home, "worker", "runs", `${run}-1`);
  76: 
  77: /** Whatever a test left running is stopped and taken away, so the next one starts on a machine with nothing on it. */
  78: function clearRuns() {
  79:   const runs = join(home, "worker", "runs");
  80:   if (!existsSync(runs)) return;
  81:   for (const id of readdirSync(runs)) {
  82:     const file = join(runs, id, "entry.json");
  83:     try {
  84:       const entry = JSON.parse(readFileSync(file, "utf8"));
  85:       if (entry.pid) stopRun(entry.pid, true);
  86:     } catch {}
  87:     for (let tries = 0; tries < 40 && existsSync(file); tries++) {
  88:       try {
  89:         rmSync(join(runs, id), { recursive: true, force: true });
  90:       } catch {}
  91:       if (existsSync(join(runs, id))) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50);
  92:     }
  93:   }
  94: }
