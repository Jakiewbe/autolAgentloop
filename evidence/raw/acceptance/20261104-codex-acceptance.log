app/tests/helpers.ts
   1: // Each test file runs in its own process with its own home and the fixture rules; modules are imported after this sets
   2: // the environment they read.
   3: import { mkdtempSync, rmSync } from "node:fs";
   4: import { tmpdir } from "node:os";
   5: import { join } from "node:path";
   6: import { after } from "node:test";
   7: 
   8: /**
   9:  * Removes a test's home. Windows refuses to delete a database file another handle in this process still has open, and
  10:  * this process keeps its hub open until it exits, so the retry then the two errors that means are what is left: a
  11:  * temporary folder not deleted is not a failed test.
  12:  */
  13: function removeHome(directory: string) {
  14:   try {
  15:     rmSync(directory, { recursive: true, force: true, maxRetries: 10, retryDelay: 50 });
  16:   } catch (error) {
  17:     const code = (error as NodeJS.ErrnoException).code;
  18:     if (code !== "EPERM" && code !== "EBUSY") throw error;
  19:   }
  20: }
  21: 
  22: export function setup(name: string, rules = "rules.fixture.json") {
  23:   const directory = mkdtempSync(join(tmpdir(), `agent-autoloop-${name}-`));
  24:   process.env.AGENT_AUTOLOOP_HOME = directory;
  25:   // Where Windows keeps a startup script is this test's own folder, never the one the owner signs in with.
  26:   if (process.platform === "win32") process.env.APPDATA = join(directory, "appdata");
  27:   process.env.AGENT_AUTOLOOP_RULES = rules.startsWith("/") ? rules : join(import.meta.dirname, rules);
  28:   process.env.AGENT_AUTOLOOP_PUBLIC_URL = "https://hub.test";
  29:   after(() => removeHome(directory));
  30:   return directory;
  31: }
  32: 
  33: /** A moment in a test's own time, minutes after a fixed start: 10:00 in Asia/Shanghai. */
  34: export const at = (minutes: number) => Date.parse("2026-10-18T02:00:00.000Z") + minutes * 60_000;
tools/checks/check_source_baseline.py
   1: #!/usr/bin/env python3
   2: """核对 evidence/source-baseline.json 与当前 app/ 工作区。
   3: 
   4: 防的失败方式：
   5: 1. 基线说「固定在某个上游提交」，但工作区 HEAD 已经变了 —— 改动来源说不清。
   6: 2. 改动文件被悄悄替换或回退，文档里的哈希与实物不符。
   7: 3. 上游 blob 被本地内容顶替 —— 等于拿本地文件冒充上游基线。
   8: 4. 夹带基线里没有的改动。
   9: 5. 任务书、GOAL 这类治理文件被顺手改掉。
  10: 
  11: 只读：不写文件、不提交、不建分支。退出码 0 全过、1 有任一不符。
  12: 用法：python -B tools/checks/check_source_baseline.py
  13: """
  14: from __future__ import annotations
  15: 
  16: import hashlib
  17: import json
  18: import subprocess
  19: import sys
  20: from pathlib import Path
  21: 
  22: ROOT = Path(__file__).resolve().parents[2]
  23: APP = ROOT / "app"
  24: BASELINE = ROOT / "evidence" / "source-baseline.json"
  25: rows: list[tuple[str, bool, str]] = []
  26: 
  27: 
  28: def check(name: str, ok: bool, detail: str = "") -> None:
  29:     rows.append((name, ok, detail))
  30: 
  31: 
  32: def sha256_bytes(b: bytes) -> str:
  33:     return hashlib.sha256(b).hexdigest()
  34: 
  35: 
  36: def sha256_file(p: Path) -> str:
  37:     return sha256_bytes(p.read_bytes())
  38: 
  39: 
  40: def git(*args: str) -> bytes:
  41:     out = subprocess.run(["git", *args], cwd=APP, capture_output=True)
  42:     if out.returncode != 0:
  43:         raise RuntimeError(out.stderr.decode("utf-8", "replace").strip())
  44:     return out.stdout
  45: 
  46: 
  47: def main() -> int:
  48:     if not BASELINE.exists():
  49:         print(f"缺基线文件：{BASELINE}")
  50:         return 1
  51:     base = json.loads(BASELINE.read_text(encoding="utf-8"))
  52:     commit = base["baselineCommit"]
  53: 
  54:     url = git("remote", "get-url", "origin").decode().strip()
  55:     check("origin 是记录的上游", url.rstrip("/").removesuffix(".git") == base["upstream"].rstrip("/").removesuffix(".git"), url)
  56:     head = git("rev-parse", "HEAD").decode().strip()
  57:     check("HEAD 等于基线提交", head == commit, head[:12])
  58:     branch = git("rev-parse", "--abbrev-ref", "HEAD").decode().strip()
  59:     check("仍在 detached HEAD（没建分支）", branch == "HEAD", branch)
  60: 
  61:     lic = APP / "LICENSE"
  62:     want_lic = base["contentHashes"]["license_sha256"]
  63:     check("许可证文件哈希", lic.exists() and sha256_file(lic) == want_lic)
  64: 
  65:     for item in base["contentHashes"]["modified"]:
  66:         p = APP / item["path"]
  67:         got = sha256_file(p) if p.exists() else "<missing>"
  68:         check(f"本地 {item['path']}", got == item["local"], got[:12])
  69:         blob = sha256_bytes(git("show", f"{commit}:{item['path']}"))
  70:         check(f"上游 {item['path']}", blob == item["upstream"], blob[:12])
  71: 
  72:     for item in base["contentHashes"]["added"]:
  73:         p = APP / item["path"]
  74:         got = sha256_file(p) if p.exists() else "<missing>"
  75:         check(f"新增 {item['path']}", got == item["sha256"], got[:12])
  76: 
  77:     bundle = base["contentHashes"]["bundle"]
  78:     patch = ROOT / base["windowsChangeBundle"]["patch"]
  79:     check("补丁哈希", patch.exists() and sha256_file(patch) == bundle["patch_sha256"])
  80:     tar = ROOT / bundle["deploy_tarball"]
  81:     check("部署包哈希", tar.exists() and sha256_file(tar) == bundle["deploy_sha256"])
  82: 
  83:     status = git("status", "--porcelain=v1").decode().splitlines()
  84:     modified = sorted(line[3:] for line in status if line.startswith(" M"))
  85:     untracked = sorted(line[3:] for line in status if line.startswith("??"))
  86:     check("已改文件集合一致", modified == sorted(base["changedFiles"]["modified"]), ",".join(modified))
  87:     expect_untracked = sorted(base["changedFiles"]["added"] + base["changedFiles"]["generated"])
  88:     check("未跟踪文件集合一致", untracked == expect_untracked, ",".join(untracked))
  89: 
  90:     for g in base.get("governanceHashes", []):
  91:         p = ROOT / g["path"]
  92:         if not p.exists():
  93:             check(f"治理 {g['path']}", False, "缺文件")
  94:             continue
  95:         ok = sha256_file(p) == g["sha256"]
  96:         if g.get("volatile"):
  97:             rows.append((f"治理 {g['path']}（易变，仅报告）", True, "已变化，按约定不算失败" if not ok else "未变"))
  98:             continue
  99:         check(f"治理 {g['path']}", ok)
 100: 
 101:     width = max(len(n) for n, _, _ in rows)
 102:     for name, ok, detail in rows:
 103:         print(f"{'PASS' if ok else 'FAIL'}  {name.ljust(width)}  {detail}")
 104:     bad = [n for n, ok, _ in rows if not ok]
 105:     print(f"\n共 {len(rows)} 项，FAIL={len(bad)}")
 106:     if bad:
 107:         print("不符合项：" + "；".join(bad))
 108:         return 1
 109:     return 0
 110: 
 111: 
 112: if __name__ == "__main__":
 113:     sys.exit(main())

