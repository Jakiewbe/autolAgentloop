 342: function finish(draft: Draft, id: number, token: string, given: unknown) {
 343:   const hash = digest(JSON.stringify(given ?? null));
 344:   const prior = draft.view.get("runs", id);
 345:   // The same execution handing in again means the answer got lost: it gets the same answer, and nothing happens twice.
 346:   if (prior && prior.last_issued !== null && credential(draft.env, "run", id, prior.last_issued) === token) {
 347:     if (prior.last_result !== hash) throw new Conflict("这一次执行已经交过不一样的结果");
 348:     return { rejected: JSON.parse(prior.last_answer ?? "[]"), duplicate: true };
 349:   }
 350:   const run = heldRun(draft, id, token, ["claimed", "unknown"]);
 351:   const result = parseResult(given);
 352:   const session = result.session ?? run.session;
 353:   const usage = result.usage
 354:     ? JSON.stringify(addUsage(run.usage ? JSON.parse(run.usage) : undefined, result.usage))
 355:     : run.usage;
 356:   put(draft, "runs", id, { last_issued: run.issued, last_result: hash, issued: null, session, usage });
 357:   let rejected: Rejected[] = [];
 358:   if (result.outcome === "failed") rejected = retryLater(draft, run, result);
 359:   else if (result.outcome === "cancelled") {
 360:     put(draft, "runs", id, {
